# Chuỗi kết nối tới Database PostgreSQL của bạn.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Mật khẩu để đăng nhập vào trang Web Admin UI (Username mặc định là: admin)
ADMIN_PASSWORD=your_secure_password_here
